# Copy to .env (never commit .env).
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=mysql+asyncmy://payforge:payforge@127.0.0.1:3307/payforge
SIMBANK_URL=http://127.0.0.1:4000
SIMBANK_TIMEOUT_SECONDS=3
REDIS_URL=redis://127.0.0.1:6381/0

# "Sign in with GitHub": create an OAuth app at github.com/settings/developers with the
# callback URL http://localhost:3000/auth/github/callback (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SimBank (the fake bank)
SIMBANK_SLOW_SECONDS=8

# Access tokens for merchant servers. Generate a key with:
#   uv run python -m payforge.keys secrets/jwt-es256.pem
# Empty = a throwaway key per process (development only: tokens die on restart)
JWT_PRIVATE_KEY_FILE=
